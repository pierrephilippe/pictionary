{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pictionary-hologram",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "pictionary-hologram-staging",
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_ROOM",
            "class_name": "GameRoom"
          }
        ]
      },
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    },
    "production": {
      "name": "pictionary-hologram",
      "routes": [
        {
          "pattern": "pictionary.fady.eu",
          "custom_domain": true
        }
      ],
      "workers_dev": false,
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_ROOM",
            "class_name": "GameRoom"
          }
        ]
      },
      "vars": {
        "ENVIRONMENT": "production"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    }
  }
}
