{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pictionary-hologram-test",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "development"
  },
  "ratelimits": [
    {
      "name": "CREATE_ROOM_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "JOIN_ROOM_RATE_LIMITER",
      "namespace_id": "41002",
      "simple": { "limit": 40, "period": 60 }
    },
    {
      "name": "TICKET_IP_RATE_LIMITER",
      "namespace_id": "41003",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "TICKET_SESSION_RATE_LIMITER",
      "namespace_id": "41004",
      "simple": { "limit": 12, "period": 60 }
    }
  ]
}
